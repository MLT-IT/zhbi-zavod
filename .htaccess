RewriteRule ^prosmotrennye/?$ / [L,R=301]
RewriteRule ^gazobetonnye-doma/?$ / [L,R=301]

RewriteRule ^fundamenty/uff-uteplennaya-finskaya-plita/?$ / [L,R=301]
RewriteRule ^proektirovanie-domov/?$ / [L,R=301]
RewriteRule ^postroennye-doma/?$ / [L,R=301]

RewriteRule ^postroennye-doma/dom-iz-kirpicha-v-beloostrove/?$ / [L,R=301]
RewriteRule ^postroennye-doma/dom-iz-kleenogo-brusa-v-primorske/?$ / [L,R=301]
RewriteRule ^postroennye-doma/karkasnyij-dom-v-razmetelevo/?$ / [L,R=301]
RewriteRule ^postroennye-doma/dom-iz-brusa-v-sosnovo/?$ / [L,R=301]
RewriteRule ^postroennye-doma/dom-iz-gazobetona-v-losevo/?$ / [L,R=301]
RewriteRule ^postroennye-doma/karkasnyij-dom-v-agalatovo/?$ / [L,R=301]
RewriteRule ^postroennye-doma/dom-iz-brusa-v-garbolovo/?$ / [L,R=301]
RewriteRule ^postroennye-doma/dom-iz-gazobetona-v-primorske/?$ / [L,R=301]

RewriteRule ^sovremennye-doma/?$ / [L,R=301]
RewriteRule ^sovremennye-doma\.html/?$ / [L,R=301]

RewriteRule ^fundamenty/lentochnyj/?$ / [L,R=301]
RewriteRule ^fundamenty/zabivnye-zhb-svai/?$ / [L,R=301]

RewriteRule ^inzhenernye-sistemy-i-kommunikacii/?$ / [L,R=301]
RewriteRule ^dizajn-landshaftnyj/?$ / [L,R=301]
RewriteRule ^dizajn-landshaftnyij/?$ / [L,R=301]

RewriteRule ^servicepages/confidentalpolicy/?$ / [L,R=301]
RewriteRule ^karta-sajta/?$ / [L,R=301]
RewriteRule ^favicon-32x32\.png/?$ / [L,R=301]















# Redirect the manager to a specific domain - don't rename the ht.access file
# in the manager folder to use this this rule
#RewriteCond %{HTTP_HOST} !^example\.com$ [NC]
#RewriteCond %{REQUEST_URI} ^/manager [NC]
#RewriteRule ^(.*)$ https://example.com/$1 [R=301,L]


# The Friendly URLs part
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?q=$1 [L,QSA]


# For servers that support output compression, you should pick up a bit of
# speed by un-commenting the following lines.

#php_flag zlib.output_compression On
#php_value zlib.output_compression_level 5
