extends ../pug/base/_head
include ../pug/sections/_contacts
include ../pug/blocks/_breadcrumbs
include ../pug/sections/_main-infoblock


block vars
    - const title = 'Каталог'

block content
    body
        .layout
            // - HEADER
            include ../pug/sections/_header

            // - CONTENT
            main.layout__main

                section.section.section_view_top
                    +breadcrumbs(['Главная', 'Каталог']).section__breadcrumbs

                    include ../pug/sections/_catalog-screen


                include ../pug/sections/_catalog

                include ../pug/sections/_content-block

                +main-infoblock(true)

                include ../pug/sections/_payment-ways

                +contacts(true)

            // - FOOTER
            include ../pug/sections/_footer

            // - POPUPS AND OTHER

            include ../pug/blocks/_burger-menu

            .popups
                include ../pug/popups/_popup-availability
                include ../pug/popups/_popup-callback

        // - SCRIPTS
        include ../pug/base/_scripts
