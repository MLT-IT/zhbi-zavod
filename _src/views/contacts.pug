extends ../pug/base/_head
include ../pug/sections/_main-screen
include ../pug/blocks/_breadcrumbs

block vars
    - const title = 'Контакты'

block content
    body
        .layout
            // - HEADER
            include ../pug/sections/_header

            // - CONTENT
            main.layout__main

                +breadcrumbs(['Главная', 'Контакты'])

                include ../pug/sections/_contacts-separate

                include ../pug/sections/_advantages

            // - FOOTER
            include ../pug/sections/_footer

            // - POPUPS AND OTHER

            include ../pug/blocks/_burger-menu

            .popups
                include ../pug/popups/_popup-availability
                include ../pug/popups/_popup-callback

        // - SCRIPTS
        include ../pug/base/_scripts
