doctype html
html
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title Monolit
    body
        .content
            .block
                .block__title Главная
                ul.block__list
                    li
                        a(href="./main.html") Главная страница
                    li
                        a(href="./catalog.html") Каталог
                    li
                        a(href="./product.html") Карточка товара
                    li
                        a(href="./cart.html") Корзина
                    li
                        a(href="./contacts.html") Контакты
                    li
                        a(href="./delivery.html") Доставка

        style(type="text/css").

            body {
                background: #E9E9E9;
                margin: 0;
            }

            .content {
                max-width: 1280px;
                width: 100%;
                margin-left: auto;
                margin-right: auto;
                padding: 60px 20px;
                box-sizing: border-box;
                font-family: Calibri, sans-serif;
                color: #000000;
            }

            .block {
                margin-bottom: 40px;
            }

            .block + .block {
                border-top: 1px solid #000000;
                padding-top: 40px;
            }

            .block__title {
                margin-bottom: 20px;
                font-size: 17px;
                line-height: 20px;
                font-weight: 600;
            }

            .block__list {
                list-style: none;
                padding: 0;
                font-weight: 400;
                font-size: 16px;
                line-height: 20px;
            }

            .block__list li {
                display: flex;
                align-items: center;
            }

            .block__list li::before {
                content: '';
                width: 10px;
                height: 10px;
                background: #000000;
                border-radius: 3px;
                margin-right: 12px;
            }

            .block__list a {
                text-decoration: none;
                color: #000000;
            }

            .block__list li:not(:last-child) {
                margin-bottom: 24px;
            }

